{
  "name": "nk-activity",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/preflight.mjs --production && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply nk-activity-db --local",
    "db:remote": "node scripts/preflight.mjs --production && wrangler d1 migrations apply nk-activity-db --remote",
    "test": "vitest run",
    "webhook:set": "node scripts/set-webhook.mjs",
    "preflight": "node scripts/preflight.mjs --ci"
  },
  "dependencies": {
    "hono": "^4.6.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "4.165.0"
  }
}
